# Copy to .env and fill in the first three values. .env is git-ignored.

# Public broker (Terraform output kafka_bootstrap_servers)
KAFKA_BOOTSTRAP=broker.13-200-55-154.sslip.io:9094
# A readwrite app from APP_USERS and its password (see README.md)
KAFKA_USERNAME=kafka_test
KAFKA_PASSWORD=

# Optional (defaults shown)
# KAFKA_SECURITY_PROTOCOL=SASL_SSL      # PLAINTEXT for kafka:29092 inside Docker
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_TOPIC=test-topic
# TOPIC_PARTITIONS=3                    # only used when the topic is created
# TOPIC_REPLICATION=1
# MESSAGE_COUNT=10                      # 0 = send until stopped
# MESSAGE_INTERVAL_SEC=1
# GROUP_ID=kafka-test                   # change it to read everything again
# IDLE_TIMEOUT_SEC=0                    # consumer stops after this many idle seconds; 0 = never
