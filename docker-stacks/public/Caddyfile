# Caddy gets and renews HTTPS certificates automatically for these hostnames.
# PUBLIC_HOST looks like 65-2-137-133.sslip.io, which resolves to 65.2.137.133.

pgadmin.{$PUBLIC_HOST} {
	reverse_proxy pgadmin:80
}

kafka.{$PUBLIC_HOST} {
	reverse_proxy kafka-ui:8080
}

# Not websites: these blocks only make Caddy obtain certificates, which
# scripts/tls-certs.sh hands to Postgres (5432) and Kafka (9094).
db.{$PUBLIC_HOST}, broker.{$PUBLIC_HOST} {
	respond "Not a website: connect with a Postgres (5432) or Kafka (9094) client." 404
}
